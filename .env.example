# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL / TiDB Cloud Database Configuration (Online Database / Vercel Environment Variables)
# Masukkan konfigurasi ini pada .env lokal atau Vercel Project Settings > Environment Variables:
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=349mpFScgYPyr7v.root
MYSQL_PASSWORD=
MYSQL_DATABASE=db_presensi_pkl
MYSQL_SSL=true

# ATAU MENGGUNAKAN SATU CONNECTION STRING DATABASE_URL:
# DATABASE_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_presensi_pkl?ssl={"rejectUnauthorized":true}

# ATAU FORMAT ALTERNATIF (DB_*):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=db_presensi_pkl
