rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'puputsasmita19@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /presensi/{presensiId} {
      allow read, write: if true;
    }

    match /jurnal/{jurnalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
